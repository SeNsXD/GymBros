<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="REST TIMER"
            android:textColor="#38E89F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/rest_timer_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="#F5F7FA"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/rest_timer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/notification_rest_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rest_timer_minus"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/notification_action_minus"
            android:gravity="center"
            android:text="−15s"
            android:textColor="#FA2A55"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rest_timer_plus"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/notification_action_plus"
            android:gravity="center"
            android:text="+30s"
            android:textColor="#38E89F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rest_timer_skip"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.25"
            android:background="@drawable/notification_action_skip"
            android:gravity="center"
            android:text="Skip rest"
            android:textColor="#A78BFA"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
